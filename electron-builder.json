{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.lykn.desktop",
  "productName": "LYKN",
  "copyright": "Copyright © LYKN",
  "directories": {
    "output": "release",
    "buildResources": "electron/resources"
  },
  "files": [
    "!.worktrees/**",
    "electron/**/*",
    "lib/browserScreen.cjs",
    "lib/webSearchIntent.cjs",
    "package.json",
    "!**/node_modules/**",
    "node_modules/electron-updater/**",
    "node_modules/builder-util-runtime/**",
    "node_modules/fs-extra/**",
    "node_modules/graceful-fs/**",
    "node_modules/jsonfile/**",
    "node_modules/universalify/**",
    "node_modules/js-yaml/**",
    "node_modules/argparse/**",
    "node_modules/lazy-val/**",
    "node_modules/lodash.escaperegexp/**",
    "node_modules/lodash.isequal/**",
    "node_modules/semver/**",
    "node_modules/tiny-typed-emitter/**",
    "node_modules/debug/**",
    "node_modules/ms/**",
    "node_modules/sax/**",
    "node_modules/pdfjs-dist/package.json",
    "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
    "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
    "node_modules/pdfjs-dist/standard_fonts/**",

    "node_modules/@huggingface/**",
    "node_modules/onnxruntime-node/**",
    "node_modules/onnxruntime-common/**",
    "node_modules/sharp/**",
    "node_modules/@img/**",
    "node_modules/detect-libc/**",
    "node_modules/adm-zip/**",
    "node_modules/global-agent/**",
    "node_modules/boolean/**",
    "node_modules/es6-error/**",
    "node_modules/matcher/**",
    "node_modules/escape-string-regexp/**",
    "node_modules/roarr/**",
    "node_modules/semver-compare/**",
    "node_modules/serialize-error/**",
    "node_modules/json-stringify-safe/**",
    "node_modules/sprintf-js/**",
    "node_modules/globalthis/**",
    "node_modules/define-properties/**",
    "node_modules/object-keys/**",
    "node_modules/has-property-descriptors/**",
    "node_modules/define-data-property/**",
    "node_modules/es-define-property/**",
    "node_modules/es-errors/**",
    "node_modules/gopd/**",
    "node_modules/detect-node/**",
    "node_modules/type-fest/**",
    "node_modules/flatbuffers/**",
    "node_modules/guid-typescript/**",
    "node_modules/long/**",
    "node_modules/platform/**",
    "node_modules/protobufjs/**",
    "node_modules/@protobufjs/**",

    "node_modules/esbuild/**",
    "node_modules/@esbuild/**",

    "!node_modules/onnxruntime-web/**",
    "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
    "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
    "!node_modules/@huggingface/transformers/types/**",
    "!electron/**/*.test.{cjs,mjs,js}"
  ],
  "asarUnpack": [
    "**/node_modules/onnxruntime-node/bin/**",
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/node_modules/@esbuild/**"
  ],
  "extraResources": [
    {
      "from": "extensions/save-to-lykn",
      "to": "extensions/save-to-lykn",
      "filter": ["**/*"]
    },
    {
      "from": "models",
      "to": "models",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "name": "lykn",
    "productName": "LYKN",
    "main": "electron/main.cjs",
    "type": "commonjs"
  },
  "afterSign": "electron/notarize.cjs",
  "protocols": [
    {
      "name": "LYKN",
      "schemes": ["lykn"]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "electron/resources/icon-rounded.png",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "x64ArchFiles": "**/node_modules/{esbuild,@esbuild/darwin-*,@img/sharp-*,onnxruntime-node}/**",
    "notarize": false,
    "entitlements": "electron/resources/entitlements.mac.plist",
    "entitlementsInherit": "electron/resources/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "LYKN uses your microphone for voice conversations.",
      "NSCameraUsageDescription": "LYKN may use your camera for visual context.",
      "NSScreenCaptureUsageDescription": "LYKN reads what's on your screen when you ask it to, so it can give feedback and take notes.",
      "NSAppleEventsUsageDescription": "LYKN reads your open browser tabs so it can bring them into its own browser when you choose to sync.",
      "LSMultipleInstancesProhibited": true
    }
  },
  "dmg": {
    "title": "LYKN ${version}",
    "artifactName": "${productName}.dmg",
    "icon": "electron/resources/icon-rounded.png",
    "background": "electron/resources/dmgBackground.tiff",
    "iconSize": 110,
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 130, "y": 200 },
      { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "icon": "electron/resources/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "artifactName": "${productName}-Setup.${ext}",
    "executableName": "LYKN"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LYKN",
    "uninstallDisplayName": "LYKN",
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "elijahlykins",
    "repo": "lykn-releases"
  }
}
