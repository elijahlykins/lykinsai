{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.lykn.desktop",
  "productName": "LYKN",
  "copyright": "Copyright © LYKN",
  "directories": {
    "output": "release",
    "buildResources": "electron/resources"
  },
  "files": [
    "electron/**/*",
    "lib/browserScreen.cjs",
    "lib/webSearchIntent.cjs",
    "package.json",
    "!**/node_modules/**",
    "node_modules/electron-updater/**",
    "node_modules/builder-util-runtime/**",
    "node_modules/fs-extra/**",
    "node_modules/graceful-fs/**",
    "node_modules/jsonfile/**",
    "node_modules/universalify/**",
    "node_modules/js-yaml/**",
    "node_modules/argparse/**",
    "node_modules/lazy-val/**",
    "node_modules/lodash.escaperegexp/**",
    "node_modules/lodash.isequal/**",
    "node_modules/semver/**",
    "node_modules/tiny-typed-emitter/**",
    "node_modules/debug/**",
    "node_modules/ms/**",
    "node_modules/sax/**",
    "node_modules/pdfjs-dist/package.json",
    "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
    "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
    "node_modules/pdfjs-dist/standard_fonts/**"
  ],
  "extraResources": [
    {
      "from": "extensions/save-to-lykn",
      "to": "extensions/save-to-lykn",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "name": "lykn",
    "productName": "LYKN",
    "main": "electron/main.cjs",
    "type": "commonjs"
  },
  "afterSign": "electron/notarize.cjs",
  "protocols": [
    {
      "name": "LYKN",
      "schemes": ["lykn"]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "electron/resources/icon-rounded.png",
    "target": [
      { "target": "dmg", "arch": ["universal"] },
      { "target": "zip", "arch": ["universal"] }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": false,
    "entitlements": "electron/resources/entitlements.mac.plist",
    "entitlementsInherit": "electron/resources/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "LYKN uses your microphone for voice conversations.",
      "NSCameraUsageDescription": "LYKN may use your camera for visual context.",
      "NSScreenCaptureUsageDescription": "LYKN reads what's on your screen when you ask it to, so it can give feedback and take notes."
    }
  },
  "dmg": {
    "title": "LYKN ${version}",
    "artifactName": "${productName}.dmg",
    "icon": "electron/resources/icon-rounded.png",
    "background": "electron/resources/dmgBackground.tiff",
    "iconSize": 110,
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 130, "y": 200 },
      { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "icon": "electron/resources/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "artifactName": "${productName}-Setup.${ext}",
    "executableName": "LYKN"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LYKN",
    "uninstallDisplayName": "LYKN",
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "elijahlykins",
    "repo": "lykn-releases"
  }
}
