# Eval arm configuration — append to .env to run the harness.
# Arms are resolved server-side; the client only ever names an arm id.
BROWSER_AGENT_EVAL_ARMS_ENABLED=1
BROWSER_AGENT_EVAL_USER_IDS=            # comma-separated; empty = any authed user

# Planner: fixed across every arm.
BROWSER_AGENT_PLAN_MODEL=claude-opus-5
BROWSER_AGENT_PLAN_EFFORT=low

# Middle model per arm (envKey from arms.json).
BROWSER_AGENT_ARM_LUNA_REFS_MODEL=gpt-5.6-luna
BROWSER_AGENT_ARM_LUNA_REFS_EFFORT=low
BROWSER_AGENT_ARM_LUNA_HOLO_MODEL=gpt-5.6-luna
BROWSER_AGENT_ARM_LUNA_HOLO_EFFORT=low
BROWSER_AGENT_ARM_GEMINI_REFS_MODEL=gemini-3.7-flash
BROWSER_AGENT_ARM_GEMINI_REFS_EFFORT=low
BROWSER_AGENT_ARM_GEMINI_HOLO_MODEL=gemini-3.7-flash
BROWSER_AGENT_ARM_GEMINI_HOLO_EFFORT=low

# Grounder: fixed across the two holo arms.
BROWSER_AGENT_GROUND_MODEL=holo3-1-35b-a3b

# --- Phase 5 runner -------------------------------------------------------
# A DEDICATED eval account. The harness drives a browser as this identity for
# hours unattended; never point it at a real user.
LYKN_EVAL_EMAIL=
LYKN_EVAL_PASSWORD=
# Where the agent-model/agent-ground routes live.
LYKN_API_BASE=https://app.lykn.io
