# LYKN production environment template. Copy only the variables needed by
# each deployment surface. Names only - never commit real values.
#
# Vercel receives only the public VITE_* block.
# Render receives the backend blocks, including the two public Supabase values
# because the server also verifies Supabase JWTs with them.
# Desktop signing variables belong only on the trusted release machine or CI.
# Names only — never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://api.lykn.io
VITE_FRONTEND_BASE_URL=https://lykn.io
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Supabase backend secret (Render only) ──────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── App URLs (REQUIRED in production for Stripe return URLs) ────────────────
NODE_ENV=production
APP_URL=https://lykn.io
PUBLIC_API_BASE_URL=https://api.lykn.io
ALLOWED_ORIGINS=https://lykn.io,https://www.lykn.io
ARTIFACTS_BASE_URL=https://artifacts.lykn.io

# ── Stripe core ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Stripe subscription Prices ──────────────────────────────────────────────
# Internal plan ids map to products as: studio = Pro, student = Student, max = Max.
# "studio" is the historical DB plan id for the Pro product (user_billing.plan);
# it is kept for subscription/DB compatibility. Display name is always "Pro"
# (lib/billing/planCatalog.js is the canonical mapping).
# Pro $20/month (must be a real price_... id; NOT the legacy $25 Price).
STRIPE_PRICE_STUDIO_MONTHLY=
# Pro $204/year.
STRIPE_PRICE_STUDIO_ANNUAL=
# Legacy Pro $25/month Price id — migration reference only, never checkout.
STRIPE_PRICE_STUDIO_MONTHLY_LEGACY=
# Student $15/month.
STRIPE_PRICE_STUDENT_MONTHLY=
# Student $144/year.
STRIPE_PRICE_STUDENT_ANNUAL=
# Max $100/month.
STRIPE_PRICE_MAX_MONTHLY=
# Max $900/year.
STRIPE_PRICE_MAX_ANNUAL=

# ── Historical credit packs (retired from sale) ─────────────────────────────
# Leave unset unless delayed webhooks for old pack purchases must still grant.
STRIPE_PRICE_TOPUP_1000=
STRIPE_PRICE_TOPUP_5000=
STRIPE_PRICE_TOPUP_15000=

# ── Billing behavior ────────────────────────────────────────────────────────
# Days for the optional trial checkout flow.
STRIPE_TRIAL_DAYS=7
# Set to 1 to escalate stripe_price_config warnings to errors outside prod.
LYKN_BILLING_STRICT=

# ── Required backend security values (Render only) ─────────────────────────
# Generate the first, second, and fourth with: openssl rand -base64 32
BACKFILL_SECRET=
ADMIN_INGEST_SECRET=
VOICE_SESSION_SECRET=
# Exactly 64 hexadecimal characters. Generate with: openssl rand -hex 32
CONNECTOR_TOKEN_KEY=
# Comma-separated server-side admin allowlist.
ADMIN_EMAILS=

# ── Model and usage platform (Render only) ─────────────────────────────────
# Primary chat gateway.
OPENROUTER_API_KEY=
# Direct providers are optional fallbacks and power provider-specific features.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# Set deliberately. Example: 20 means a 1.20x customer charge.
CUSTOMER_USAGE_MARKUP_PERCENT=
# Incident escape hatch. Set to direct only when bypassing OpenRouter.
LYKN_CHAT_GATEWAY=

# ── Managed connected apps (Render only) ──────────────────────────────────
COMPOSIO_API_KEY=

# ── Transactional email and search (optional, Render only) ─────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SECURITY_FROM_EMAIL=
SERPER_API_KEY=
YOUTUBE_API_KEY=

# ── Voice (optional, Render only) ──────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET=

# ── Desktop release signing (release environment only) ─────────────────────
GH_TOKEN=
# electron-builder certificate source and password, required for Windows.
CSC_LINK=
CSC_KEY_PASSWORD=
# Preferred App Store Connect API-key notarization path.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Alternative Apple-ID notarization path.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
