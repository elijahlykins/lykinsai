# ============================================================================
# LYKN — environment variables (`.env.example`)
# ============================================================================
# Copy this file to `.env` and fill in the values that apply to your
# deployment. Anything left blank simply disables that feature; the server
# logs which integrations are enabled / disabled at boot.
#
# VALUES IN THIS FILE ARE PLACEHOLDERS. The matching gitleaks allowlist
# (`.gitleaks.toml`) whitelists the `your-*-here` placeholder shape so the
# pre-commit hook does not flag this file. Never substitute real secrets
# here — keep them in `.env` (which is `.gitignore`d).
#
# AGENT 05 SECURITY NOTES
# -----------------------
# • Server secrets must NEVER be `VITE_`-prefixed. Vite bundles every
#   `VITE_*`-prefixed variable into the browser JavaScript bundle. The
#   only `VITE_*` values that are safe to set are listed in the
#   "Browser-safe" block at the bottom — and those are intentionally
#   public (Supabase URL, Supabase anon key, Stripe publishable key, etc.).
# • Three operator-cron secrets (`BACKFILL_SECRET`, `DISCOVER_INGEST_SECRET`,
#   `ADMIN_INGEST_SECRET`) MUST be at least 32 characters in production
#   per the Agent 02 / Agent 05 runbook (see `ROTATION_RUNBOOK.md`).
#   The application currently enforces an 8-character floor at point-of-use
#   for backwards compatibility; the in-code floor will be raised after
#   every deployment has been rotated to a 32-char value.
# • `validateSecrets()` runs at server startup (see `validateSecrets.js`).
#   In `NODE_ENV=production` the server REFUSES TO START if any required
#   secret is missing or below its minimum length. In dev it warns instead.
# • Generate strong secrets with one of:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#     openssl rand -base64 32
#   For `CONNECTOR_TOKEN_KEY` (must be exactly 32 bytes for AES-256-GCM):
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     openssl rand -hex 32

# ============================================
# CORE URLS
# ============================================
# Public origin of the deployed web app (used by OAuth popups + Stripe
# Checkout success/cancel redirects). Example: https://lykn.io
APP_URL=
# Same value as APP_URL — used by some legacy code paths.
FRONTEND_URL=
# Optional override for OAuth callback hosts in dev. Defaults to APP_URL.
FRONTEND_BASE_URL=
# Public origin of the API server (where /oauth/callback/* routes live).
# Render sets RENDER_EXTERNAL_URL automatically; set this only if you want
# to override.
PUBLIC_API_BASE_URL=
# Optional CORS allowlist override (comma-separated). Production typically
# leaves this blank and relies on the in-code allowlist + LYKN preview-host
# regex. Set to override during incident triage if a legitimate origin is
# being blocked.
ALLOWED_ORIGINS=

# Bind host. Defaults to 0.0.0.0 in production (Render's edge proxy needs
# this), 127.0.0.1 in dev (loopback only — keeps the dev server off LAN).
HOST=
# Bind port. Render assigns this automatically; defaults to 3001 in dev.
PORT=
# Standard Node mode flag. Set to `production` on Render.
NODE_ENV=

# ============================================
# SUPABASE (DATABASE + AUTH)
# ============================================
# Server-only service-role key — bypasses RLS. NEVER VITE_-prefix this.
# Get it from Supabase Dashboard → Settings → API → service_role key.
# Required in production. Generate length is fixed by Supabase (~150 chars).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt-here

# Browser-safe values — these are intentionally public (Vite bundles them).
# RLS on every user-scoped table is the actual access control.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# STRIPE BILLING
# ============================================
# Get these from https://dashboard.stripe.com
# - Developers → API keys           → STRIPE_SECRET_KEY (sk_...)
# - Developers → Webhooks → endpoint → STRIPE_WEBHOOK_SECRET (whsec_...)
#   For local dev: `stripe listen --forward-to localhost:3001/api/stripe/webhook`
#   prints the whsec_ secret to use.
# - Products → create one per plan, then one Price per billing period
#   (monthly/annual). Copy each price id (price_...) below.
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# Stripe publishable key — public by design. Set on BOTH Vercel (VITE_*) and
# Render (STRIPE_PUBLISHABLE_KEY) so embedded checkout works even when the
# frontend build env is missing the Vite-prefixed copy.
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here

STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_STUDIO_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_PRO_ANNUAL=
# Studio Max is "coming soon"; price IDs optional until it ships.
STRIPE_PRICE_STUDIO_MAX_MONTHLY=
STRIPE_PRICE_STUDIO_MAX_ANNUAL=

# Length of the card-required Pro trial for new signups (days). Default: 7.
# Also drives the trial messaging on Stripe Checkout (custom_text near the
# pay button). In Stripe Dashboard → Products, name/describe the Pro product
# with the same trial language for the line item at the top of checkout.
STRIPE_TRIAL_DAYS=7

# ============================================
# OPERATOR-GATED CRON ENDPOINTS
# ============================================
# Bearer secrets for the three cron HTTP endpoints (verified server-side
# with `crypto.timingSafeEqual` against the env value — Agent 02 hardened
# all three).
#
# Length: ≥32 characters STRONGLY RECOMMENDED in production. The in-code
# floor is currently 8 chars (legacy compatibility); see ROTATION_RUNBOOK.md
# for the raise-to-32 rotation playbook.
#
# Generate each independently:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Bearer for POST /api/synthesis/backfill (operator-only synthesis pass)
BACKFILL_SECRET=your-32-plus-char-random-string-here

# Bearer for POST /api/discover/ingest (operator-only discovery ingest)
DISCOVER_INGEST_SECRET=your-32-plus-char-random-string-here

# Bearer for POST /api/feeds/poll-due AND /api/connections/poll-due
# (the two background poll-due endpoints). If unset, the server falls back
# to DISCOVER_INGEST_SECRET so legacy single-cron deployments keep working.
ADMIN_INGEST_SECRET=your-32-plus-char-random-string-here

# ============================================
# CONNECTOR FRAMEWORK
# ============================================
# AES-256-GCM key used to encrypt OAuth access/refresh tokens at rest.
# REQUIRED if you enable any connectors. Must be exactly 64 hex chars
# (32 bytes raw). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# Treat as a long-term secret — rotating this key invalidates every
# existing connection (every user must reconnect). See ROTATION_RUNBOOK.md
# for the safer re-encrypt-in-place rotation strategy.
CONNECTOR_TOKEN_KEY=your-64-hex-char-aes-key-here

# Background poller toggles. Default: ON for long-running deployments
# (Render, local dev), OFF for serverless. On serverless, schedule a
# 1-minute cron against POST /api/connections/poll-due with the
# Authorization: Bearer ${ADMIN_INGEST_SECRET} header.
#   1 / true  → force on
#   0 / false → force off
CONNECTOR_POLLER_ENABLED=
CONNECTOR_POLLER_INTERVAL_MS=
RSS_POLLER_ENABLED=
RSS_POLLER_INTERVAL_MS=

# ============================================
# AI PROVIDERS
# ============================================
# All four are called server-side via raw fetch (no SDK packages
# installed — verified by Agent 05). Setting at least one is required
# for any AI feature; if all four are missing, /api/ai/stream returns 503.
#
# Provider key formats / sources:
#   OpenAI:    sk-proj-...      → https://platform.openai.com/api-keys
#   Anthropic: sk-ant-...       → https://console.anthropic.com/settings/keys
#   Gemini:    (40 char alnum)  → https://aistudio.google.com/apikey
#   xAI/Grok:  xai-...          → https://console.x.ai/

OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# Gemini key — also covers the `googleapis.com/youtube/v3` calls below if
# the same Google Cloud project has the YouTube Data API enabled, but in
# practice we keep YOUTUBE_API_KEY separate for restriction-policy reasons.
GOOGLE_API_KEY=your-gemini-api-key-here
XAI_API_KEY=xai-your-grok-api-key-here

# ============================================
# OTHER SERVER-SIDE API KEYS
# ============================================

# YouTube Data API v3 (search, video metadata, transcript hints).
# https://console.cloud.google.com → APIs & Services → Credentials → API key
# Restrict to the YouTube Data API v3 to limit blast radius.
YOUTUBE_API_KEY=your-youtube-api-key-here

# Resend — transactional email (feedback, billing receipts).
# https://resend.com → API Keys
RESEND_API_KEY=re_your-resend-api-key-here
# Optional From address override.
RESEND_FROM_EMAIL=

# Serper — Google search proxy used by /api/search and discover ingest.
# https://serper.dev/api-key
SERPER_API_KEY=your-serper-api-key-here

# Last.fm public API key (used by the Last.fm connector for username-only
# scrobble fetches; users do not OAuth into Last.fm).
# https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key-here

# Meta (Instagram + Facebook) oEmbed app token — used for IG/FB embed
# previews. https://developers.facebook.com/apps → System User → Generate
# Token (oembed_read scope). Without this, IG/FB embeds fall back to
# generic preview cards.
META_APP_TOKEN=your-meta-app-token-here

# Hosted Whisper transcription endpoint (optional). If both URL and key
# are set, /api/whisper/transcribe and the YouTube QA Whisper path use
# this remote service. Otherwise WHISPER_LOCAL_URL takes over (or both
# remain unset and the feature is disabled).
WHISPER_HOSTED_URL=
WHISPER_HOSTED_API_KEY=your-whisper-hosted-key-here
# Local Whisper service URL (e.g. a sidecar Whisper container in dev).
WHISPER_LOCAL_URL=

# Trello uses a single shared API key (no client_secret) plus per-user
# tokens generated by visiting an authorize URL. Only TRELLO_API_KEY is
# stored server-side. Get yours at https://trello.com/app-key
TRELLO_API_KEY=your-trello-api-key-here

# Google Custom Search Engine ID (used alongside GOOGLE_API_KEY for the
# Discover image search path). https://cse.google.com/cse/all
GOOGLE_CSE_ID=

# ============================================
# CONNECTOR PROVIDER CREDENTIALS (OAuth)
# ============================================
# Each block below corresponds to one OAuth provider in the connections
# catalog. Skip any block to disable that provider — it stays visible in
# the UI but the dialog will show "not configured on the server."
#
# All redirect URIs follow the same pattern:
#   ${PUBLIC_API_BASE_URL}/oauth/callback/<provider-id>
# Add that exact URL to each provider's developer console.
#
# Per Agent 05's runbook, every *_CLIENT_SECRET below should be at least
# 32 chars. Most providers issue ≥40 chars by default; nothing to override.

# ── GitHub ───────────────────────────────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Scopes used: read:user, public_repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Reddit ───────────────────────────────────────────────────────────────────
# https://www.reddit.com/prefs/apps → "create another app" → web app type
# Scopes used: identity, history, save
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Notion ───────────────────────────────────────────────────────────────────
# https://www.notion.so/my-integrations → New integration → Public
# OAuth flow uses owner=user (per-user, not workspace install)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── Spotify ──────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app
# Scopes used: user-library-read, user-read-email
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Pinterest ────────────────────────────────────────────────────────────────
# https://developers.pinterest.com/apps → Create app
# Production access requires Pinterest's Trial Access → Standard upgrade.
# Scopes used: boards:read, pins:read, user_accounts:read
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ── Linear ───────────────────────────────────────────────────────────────────
# https://linear.app/settings/api/applications → New application
# Scopes used: read
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ── Todoist ──────────────────────────────────────────────────────────────────
# https://app.todoist.com/app/settings/integrations/developer → Create app
# Scopes used: data:read
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# ── Vimeo ────────────────────────────────────────────────────────────────────
# https://developer.vimeo.com/apps → Create an app
# Scopes used: public, private
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# ── Raindrop.io ──────────────────────────────────────────────────────────────
# https://app.raindrop.io/settings/integrations → Create new app
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=

# ── Dribbble ─────────────────────────────────────────────────────────────────
# https://dribbble.com/account/applications/new
# Scopes used: public
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# ── Google (YouTube + Drive + Calendar + Gmail) ─────────────────────────────
# Single Google Cloud project covers all four services.
# https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID → Web application
# Add redirect URIs for each provider:
#   ${PUBLIC_API_BASE_URL}/oauth/callback/youtube
#   ${PUBLIC_API_BASE_URL}/oauth/callback/google-drive
#   ${PUBLIC_API_BASE_URL}/oauth/callback/google-calendar
#   ${PUBLIC_API_BASE_URL}/oauth/callback/gmail
# Enable APIs: YouTube Data API v3, Google Drive API, Google Calendar API,
# Gmail API.
# Scopes are sensitive/restricted — production access requires Google's
# OAuth verification (4–6 weeks; CASA pentest for gmail.readonly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft 365 / Outlook ─────────────────────────────────────────────────
# https://portal.azure.com → App registrations → New registration
# Supported account types: "Personal Microsoft accounts AND work/school"
# Add redirect URI: ${PUBLIC_API_BASE_URL}/oauth/callback/outlook-365
# Scopes used: offline_access, openid, email, profile, Mail.Read, User.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Slack ────────────────────────────────────────────────────────────────────
# https://api.slack.com/apps → Create New App → "From scratch"
# OAuth & Permissions → User Token Scopes:
#   stars:read, users:read, team:read, channels:read
# Redirect URI: ${PUBLIC_API_BASE_URL}/oauth/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── X / Twitter ──────────────────────────────────────────────────────────────
# https://developer.x.com → Project & app → User authentication settings
# OAuth 2.0 with PKCE; "Confidential client".
# Scopes used: tweet.read, users.read, bookmark.read, offline.access
# IMPORTANT: /bookmarks endpoint requires X API Basic tier ($200/mo).
# OAuth itself works on the Free tier — bookmarks fetching does not.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Canva ────────────────────────────────────────────────────────────────────
# https://www.canva.com/developers/integrations → New integration
# Scopes used: design:meta:read, profile:read
# Production access requires Canva Developer review.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── Instagram (oEmbed only — no full OAuth) ─────────────────────────────────
# Used as a fallback signal alongside META_APP_TOKEN; the full IG OAuth
# flow is currently disabled.
INSTAGRAM_CLIENT_ID=

# ── Per-instance providers (no env vars) ────────────────────────────────────
# Mastodon registers a fresh OAuth app on whichever instance the user
# picks at connect time. No server-side credentials required.
#
# ── Token-paste providers (no env vars) ─────────────────────────────────────
# Readwise and Bluesky use user-supplied credentials (Readwise access
# token, Bluesky handle + app password). No server-side credentials
# required.

# ============================================
# OPERATOR / FEATURE-FLAG ENVIRONMENT
# ============================================
# Comma-separated email allowlist for the admin UI gates (`requireAdmin`).
# Server-side check; never trusted from the browser.
ADMIN_EMAILS=

# Comma-separated email allowlist for users granted Pro tier features
# without a paid subscription (early adopters, comped accounts).
COMPED_PRO_EMAILS=

# Cap on guest-tier hourly AI calls across ALL guest users (DoS guardrail
# on top of per-IP guest limits in /api/ai/stream-guest). Default: 200/hr
# if unset.
GUEST_AI_GLOBAL_HOURLY_MAX=

# Toggles whether to pull older Base44 SDK imports during build (legacy).
# Leave unset / `0` for new deployments.
BASE44_LEGACY_SDK_IMPORTS=

# Toggle for the Whisper-OCR fallback in YouTube QA. Default off.
YOUTUBE_QA_ENABLE_OCR=

# ============================================
# BROWSER-SAFE (VITE_*) FEATURE FLAGS
# ============================================
# EVERY value in this section is bundled into the browser JS by Vite.
# Never put a real secret here. Add only public configuration.

# Public origin of the API server — so the SPA knows where to send
# /api/* fetches when the SPA runs on a different host (Vercel) from
# the API (Render).
VITE_API_BASE_URL=

# Public origin of the SPA itself. Used for connector OAuth popup target
# origin — Agent 02 pinned `postMessage(..., new URL(this).origin)`.
VITE_FRONTEND_BASE_URL=

# Optional public MCP endpoint override for dev tunnels (e.g. ngrok).
VITE_PUBLIC_MCP_URL=

# Comma-separated email list for the client-side admin-UI gating. Mirrors
# ADMIN_EMAILS but is bundled into the browser.
#
# AGENT 05 NOTE — INFORMATION DISCLOSURE: any value placed here is visible
# to every user. Admin email addresses landing in the JS bundle is an
# information-disclosure issue (not a security hole — server-side
# requireAdmin still enforces). The product owner should decide whether
# to keep this client-side flag or move admin-UI gating to a server
# response (e.g. /api/account/me returns is_admin: boolean). See
# SECURITY_REPORT_05.md INFO findings.
VITE_ADMIN_EMAILS=

# Feature flag toggle (legacy Notes panel rendering). Public.
VITE_ENABLE_LEGACY_NOTES=
