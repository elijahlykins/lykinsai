{
  "name": "base44-app",
  "private": true,
  "version": "1.0.23",
  "description": "LYKN — your AI that reads your screen, scrapes pages, and takes notes.",
  "author": "LYKN",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "electron electron/main.cjs",
    "electron:dev:local-api": "LYKN_API_URL=http://localhost:3001 electron electron/main.cjs",
    "electron:dev:local": "LYKN_APP_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "electron:dev:local-full": "LYKN_APP_URL=http://127.0.0.1:5173 LYKN_API_URL=http://localhost:3001 electron electron/main.cjs",
    "welcome:demo": "concurrently -n vite,electron -c magenta,green --kill-others \"npm run dev\" \"npm run wait:vite && env -u ELECTRON_RUN_AS_NODE LYKN_FORCE_WELCOME=1 LYKN_APP_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "welcome:demo:prod": "env -u ELECTRON_RUN_AS_NODE LYKN_FORCE_WELCOME=1 electron electron/main.cjs",
    "welcome:reset": "node scripts/reset-test-account.mjs",
    "wait:vite": "node scripts/wait-for-port.mjs 127.0.0.1 5173",
    "electron:dev:local-full:wait": "npm run wait:vite && npm run electron:dev:local-full",
    "electron:pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --config electron-builder.json",
    "electron:pack:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --config electron-builder.json",
    "electron:build": "electron-builder --mac --config electron-builder.json",
    "electron:build:win": "electron-builder --win --config electron-builder.json",
    "electron:build:all": "electron-builder --mac --win --config electron-builder.json",
    "electron:release": "electron-builder --mac --publish always --config electron-builder.json",
    "electron:release:win": "electron-builder --win --publish always --config electron-builder.json",
    "electron:icons:win": "node scripts/generate-windows-icons.mjs",
    "server": "node --watch server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "dev:overlay": "concurrently -n vite,server,electron -c magenta,blue,green --kill-others \"npm run dev\" \"node server.js\" \"npm run wait:vite && env -u ELECTRON_RUN_AS_NODE LYKN_FORCE_WELCOME=1 LYKN_APP_URL=http://127.0.0.1:5173 LYKN_API_URL=http://localhost:3001 electron electron/main.cjs\"",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "test:vault": "node --import ./scripts/test-alias-loader.mjs --test src/lib/vault/attachmentsMarker.test.ts src/lib/synthesis/sourceText.test.ts src/lib/vaultContent.test.ts",
    "test:rag": "node --test lib/rag/rag.test.mjs",
    "test:security": "node --test lib/vaultAttachment.test.mjs lib/securityRegressions.test.mjs",
    "test:agent": "node --test electron/chatAgentRoute.test.mjs electron/signInWall.test.mjs electron/agentWaiting.test.mjs electron/pendingQuestion.test.cjs electron/fieldCorrection.test.cjs electron/linkShareRouting.test.cjs electron/stepTranscript.test.cjs electron/verifiedComplete.test.cjs electron/appStateAsk.test.cjs electron/routeStage.test.cjs electron/toolWriteInLoop.test.cjs electron/agentPersist.test.cjs electron/diagnostics.test.cjs electron/browser-agent/*.test.cjs electron/browser-agent/*.test.mjs lib/agentSkillRouting.test.cjs lib/agentModelProviders.test.mjs lib/browseWorkLog.test.cjs && node --import ./scripts/test-alias-loader.mjs --test src/lib/ai/agentHandoff.test.ts src/lib/agentWaitingRow.test.ts src/lib/agentChoiceRow.test.ts",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts HelloLykn out/HelloLykn.mp4",
    "remotion:render:logo": "remotion render remotion/index.ts LyknLogoReveal out/LyknLogoReveal.mp4",
    "remotion:render:spin": "remotion render remotion/index.ts LyknIconSpin out/LyknIconSpin.mp4",
    "remotion:render:pulse": "remotion render remotion/index.ts LyknIconPulse out/LyknIconPulse.mp4",
    "remotion:render:outline": "remotion render remotion/index.ts LyknIconOutline out/LyknIconOutline.mp4",
    "remotion:render:voice": "remotion render remotion/index.ts LyknVoiceOrb out/LyknVoiceOrb.mp4",
    "remotion:render:chat": "remotion render remotion/index.ts LyknChatStatus out/LyknChatStatus.mp4",
    "remotion:render:voiceagent": "remotion render remotion/index.ts LyknVoiceAgent out/LyknVoiceAgent.mp4",
    "remotion:render:projects": "remotion render remotion/index.ts LyknProjects out/LyknProjects.mp4",
    "remotion:render:synthesis": "remotion render remotion/index.ts LyknSynthesis out/LyknSynthesis.mp4",
    "remotion:render:commandl": "remotion render remotion/index.ts LyknCommandL out/LyknCommandL.mp4",
    "remotion:render:glass-overlay": "remotion render remotion/index.ts LyknGlassOverlay public/videos/lykn-glass-overlay.mp4",
    "remotion:render:studio-demo": "remotion render remotion/index.ts LyknStudioDemo public/videos/lykn-studio-demo.mp4",
    "remotion:render:studio-browser": "remotion render remotion/index.ts LyknStudioBrowser public/videos/lykn-studio-browser.mp4",
    "remotion:render:activation": "remotion render remotion/index.ts ActivationGradient out/ActivationGradient.mp4",
    "remotion:render:welcome": "remotion render remotion/index.ts LyknSayHello electron/welcome-anim.webm --codec=vp8 --image-format=png --pixel-format=yuva420p --props='{\"transparent\":true}'",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "test:eval": "node --test lib/agentModelProviders.test.mjs lib/eval/mind2webManifest.test.mjs lib/eval/runPlan.test.mjs lib/eval/submission.test.mjs lib/eval/calibration.test.mjs lib/eval/stats.test.mjs electron/eval/guard.test.cjs electron/browser-agent/timing.test.cjs electron/browser-agent/grounding.test.cjs electron/browser-agent/groundingLoop.test.cjs",
    "smoke:overlays": "env -u ELECTRON_RUN_AS_NODE electron electron/eval/overlay-smoke.cjs",
    "smoke:settle": "env -u ELECTRON_RUN_AS_NODE electron electron/eval/settle-smoke.cjs",
    "eval:verify": "node --env-file=.env scripts/eval/verify-models.mjs",
    "eval:m2w:fetch": "node --env-file-if-exists=.env scripts/eval/mind2web-fetch.mjs",
    "eval:m2w:manifest": "node scripts/eval/mind2web-build-manifest.mjs --target 72",
    "eval:m2w:token": "node --env-file-if-exists=.env scripts/eval/mint-token.mjs",
    "eval:m2w": "node --env-file-if-exists=.env scripts/eval/run-mind2web.mjs",
    "eval:m2w:calibrate": "node scripts/eval/judge-calibration.mjs",
    "eval:m2w:judge": "node --env-file-if-exists=.env scripts/eval/judge-mind2web.mjs",
    "eval:m2w:report": "node scripts/eval/report-mind2web.mjs"
  },
