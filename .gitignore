# env
.env
.env.*
!.env.example

# esbuild scratch/dump files
.esb.txt
.esbuild-check.txt

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Remotion rendered output
out

# Electron desktop build output (DMG/zip/.app artifacts)
release

# On-device embedding model — 33MB of binary fetched at build time by
# scripts/fetch-embedding-model.mjs and packaged as an app resource.
# Anchored to the repo root: lib/models (model registry source) is tracked.
/models/
/models-cache/

# Scratch store for migration rehearsals (scripts/import-from-supabase.mjs).
.local-migration/

# Cursor IDE artifacts
.cursor/

# Local API test scratch files
-w
body.json
resp.json
serper_news_sample.json

# YouTube player scrape artifacts (Agent 05) — these are 2.4MB external
# JS scrapes that polluted secret-pattern grep audits with false positives.
# Pattern matches the 13-digit YouTube video timestamp + "-player-script.js".
*-player-script.js

# Nested git worktrees. These are extra full checkouts and must stay
# out of the main tree so editors do not index them as a second repo.
.worktrees/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# npm audit scratch
npm-audit-report.json
gitleaks-report.json

# Large raw screen-recordings — exceed GitHub's 100MB file limit, keep local only.
# Web-optimized exports (e.g. lykn-demo-hero.mp4) ARE committed.
# Never commit raw recordings; only the web-optimized lykn-demo-hero.mp4 is.
*.mov

# macOS Spotlight saved-search bundles
*.cannedSearch/
eval/runs/
eval/mind2web/cache/

# Swift build output for the native actuator
native/**/.build/
